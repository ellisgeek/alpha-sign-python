{
  "name": "alpha-led-sign-emulator",
  "private": true,
  "description": "Emulates Alpha-protocol LED signs on a serial line and draws their displays in a browser.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json",
    "lint": "biome check .",
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "headless": "tsx src/host/main.ts headless",
    "serve": "tsx src/host/main.ts serve",
    "test:page": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "ws": "^8.22.1"
  }
}
